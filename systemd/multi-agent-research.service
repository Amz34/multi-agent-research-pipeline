[Unit]
Description=Multi-agent research pipeline (crashproof HTTP API)
Documentation=https://github.com/Amz34/multi-agent-research-pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@REPO_DIR@
EnvironmentFile=-@REPO_DIR@/.env
Environment=PIPELINE_HOST=127.0.0.1
Environment=PIPELINE_PORT=@PORT@
ExecStart=@REPO_DIR@/.venv/bin/python @REPO_DIR@/server.py
Restart=always
RestartSec=3
TimeoutStopSec=20
MemoryMax=1G
# Hardening: private by default, no privilege to escalate with.
# (No ProtectHome: the service writes its JSONL run logs under the repo.)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=@REPO_DIR@

[Install]
WantedBy=multi-user.target
